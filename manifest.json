{
  "manifest_version": 3,
  "name": "M365 Copilot Model Selector",
  "version": "3.5",
  "description": "Automatically selects GPT 5.5 Think Deeper on Microsoft 365 Copilot Chat",
  "browser_specific_settings": {
    "gecko": {
      "id": "m365-model-selector@evanrice.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://m365.cloud.microsoft/*"],
  "web_accessible_resources": [
    {
      "resources": ["main.js"],
      "matches": ["https://m365.cloud.microsoft/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://m365.cloud.microsoft/chat*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
